# Generates a C++ source with the TTF fonts embedded as byte arrays.
# Usage: cmake -DOUT=<file.cpp> -DFONT_DIR=<dir> -P embed_fonts.cmake
set(FONTS Inter-Regular Inter-Medium Inter-SemiBold IBMPlexMono-Regular IBMPlexMono-Medium)
file(WRITE "${OUT}" "// Generated by cmake/embed_fonts.cmake. Fonts: SIL Open Font License 1.1 (assets/fonts/OFL-*.txt).\n#include <cstddef>\nnamespace fitapp::fonts {\n")
foreach(F IN LISTS FONTS)
  file(READ "${FONT_DIR}/${F}.ttf" HEX HEX)
  string(LENGTH "${HEX}" LEN)
  math(EXPR NBYTES "${LEN} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," ARR "${HEX}")
  string(MAKE_C_IDENTIFIER "${F}" ID)
  file(APPEND "${OUT}" "alignas(4) static const unsigned char ${ID}_data[${NBYTES}] = {${ARR}};\n")
  file(APPEND "${OUT}" "extern const unsigned char* const ${ID} = ${ID}_data;\nextern const size_t ${ID}_size = ${NBYTES};\n")
endforeach()
file(APPEND "${OUT}" "}  // namespace fitapp::fonts\n")
