#include <windows.h>

1 ICON "../../assets/icon/fitsuite.ico"
1 RT_MANIFEST "fitsuite.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,2,4,0
PRODUCTVERSION 0,2,4,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "FitSuite"
            VALUE "FileDescription", "FitSuite - mouse, frame and motion calibration"
            VALUE "FileVersion", "0.2.4"
            VALUE "InternalName", "FitSuite"
            VALUE "OriginalFilename", "FitSuite.exe"
            VALUE "ProductName", "FitSuite"
            VALUE "ProductVersion", "0.2.4"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
